{
  "name": "frontend_projeto_extensao",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:vite\" \"npm:dev:orval\"",
    "dev:vite": "vite",
    "dev:test": "vite --port 5174 --mode test",
    "dev:orval": "orval -w",
    "orval:gen": "orval",
    "prepare": "lefthook install",
    "format": "prettier --write",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --bail 1",
    "test:watch": " vitest watch --bail 1",
    "test:cov": " vitest run --coverage",
    "test:e2e": " playwright test --reporter null",
    "test:e2e:ui": " playwright test --ui --reporter null",
    "test:e2e:headed": " playwright test --headed  --reporter null"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.2.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.166.2",
    "@tanstack/react-router-devtools": "^1.166.2",
    "axios": "^1.13.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@playwright/test": "^1.58.2",
    "@tanstack/router-plugin": "^1.166.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv-cli": "^9.0.0",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "jsdom": "^26.1.0",
    "lefthook": "^2.1.1",
    "msw": "^2.12.10",
    "orval": "^8.4.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
